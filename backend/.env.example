DATABASE_URL=replace-with-your-database-url
MYSQLHOST=replace-with-your-mysql-host
MYSQLPORT=3306
MYSQLUSER=replace-with-your-mysql-username
MYSQLPASSWORD=replace-with-your-mysql-password
MYSQLDATABASE=replace-with-your-mysql-database
# Generate a strong secret with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
ADMIN_EMAIL=admin@example.com
# Store a bcrypt hash here; never put the plaintext admin password in this file.
ADMIN_PASSWORD_HASH=replace-with-a-bcrypt-hash
VITE_GOOGLE_CLIENT_ID=replace-with-your-google-client-id
PORT=5000
# Comma-separated browser origins allowed to call the backend.
CORS_ORIGIN=http://localhost:3000
